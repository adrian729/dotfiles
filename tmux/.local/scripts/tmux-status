#!/usr/bin/env bash
# Status line readings for tmux.
#   tmux-status watch     keep the values tmux.conf reads current (run -b)
#   tmux-status update    refresh those values once
#   tmux-status SEGMENT…  print ollama, ram, cpu or battery segments
#
# tmux gives the whole status line 100ms to expand and draws whatever is left
# after that as empty, so on a loaded machine the forks of #() jobs alone made
# segments vanish. The status line therefore reads hidden environment variables
# that the watcher sets from outside the server, then redraws only the status
# line: setting an option would redraw every pane of every client. Every
# reading has a fixed width, so the bar does not shift.
#
# CPU and RAM refresh every quarter second and start no processes on Linux;
# the slower readings run in a second loop. Colors are tmux formats, expanded
# by tmux. Runs on macOS's bash 3.2.

SEP=$'\xee\x82\xb6'
TAB=$'\t'
STATE="${TMPDIR:-/tmp}/tmux-status-$UID"
[[ -d "$STATE" ]] || { mkdir -p "$STATE" && chmod 700 "$STATE"; } 2>/dev/null
# Overridable so tests can supply a process tree.
PROC=${TMUX_STATUS_PROC:-/proc}
if [[ -r "$PROC/meminfo" ]]; then
    LINUX=1 FAST=0.25
else
    # bash 3.2 waits only whole seconds, and macOS's readings start processes.
    LINUX='' FAST=1
fi

# State shared between runs; written atomically so a concurrent reader never
# sees a partial value.
save() { printf '%s\n' "$2" >"$STATE/$1.$$" 2>/dev/null && mv -f "$STATE/$1.$$" "$STATE/$1"; }
load() { REPLY=; read -r REPLY 2>/dev/null <"$STATE/$1"; }

# Waits on a pipe nobody writes to, which needs no sleep process; falls back to
# sleep when the watcher has not opened it or bash cannot wait fractions.
nap_fd=
nap() {
    local _
    [[ -n "$nap_fd" ]] && read -r -t "$1" -u "$nap_fd" _ 2>/dev/null
    (($? > 128)) || sleep "$1"
}

# Five columns for tenths of a percent: " 5.3%", "45.2%", " 100%".
pct() {
    if (($1 >= 1000)); then
        REPLY=" 100%"
    else
        printf -v REPLY '%2d.%d%%' $(($1 / 10)) $(($1 % 10))
    fi
}

# Sets REPLY to the busy share of all cpus in tenths of a percent, or to
# nothing when no reading is possible.
cpu_prev_total=
cpu_usage() {
    REPLY=
    if [[ -n "$LINUX" ]]; then
        local _ user nice sys idle iowait irq softirq steal total
        read -r _ user nice sys idle iowait irq softirq steal _ <"$PROC/stat" || return
        idle=$((idle + iowait))
        total=$((user + nice + sys + idle + irq + softirq + steal))
        if [[ -z "$cpu_prev_total" ]]; then
            cpu_prev_total=$total cpu_prev_idle=$idle
            nap "$FAST"
            cpu_usage
            return
        fi
        ((total > cpu_prev_total)) || return
        total=$((total - cpu_prev_total)) idle=$((idle - cpu_prev_idle))
        cpu_prev_total=$((cpu_prev_total + total)) cpu_prev_idle=$((cpu_prev_idle + idle))
        REPLY=$((((total - idle) * 2000 + total) / (2 * total)))
    else
        # macOS has no cumulative counters without a one-second sample; ps
        # reports each process's decaying average over the last minute.
        [[ -n "$ncpu" ]] || ncpu=$(sysctl -n hw.logicalcpu 2>/dev/null)
        REPLY=$(ps -A -o %cpu= 2>/dev/null | awk -v n="${ncpu:-1}" '{ s += $1 } END { if (NR) printf "%d\n", s * 10 / n + 0.5 }')
    fi
}

ram_usage() {
    REPLY=
    if [[ -n "$LINUX" ]]; then
        local key value _ total='' avail=''
        while read -r key value _; do
            case "$key" in
                MemTotal:) total=$value ;;
                MemAvailable:) avail=$value && break ;;
            esac
        done <"$PROC/meminfo"
        ((total > 0)) && [[ -n "$avail" ]] && REPLY=$((((total - avail) * 2000 + total) / (2 * total)))
    else
        # Same accounting as tmux-cpu: cached file pages count as available.
        REPLY=$(vm_stat 2>/dev/null | awk -F: '{ gsub(/[ .]/, "", $2) }
            /^Pages (active|inactive|speculative|wired down|occupied by compressor)$/ { u += $2 }
            /^Pages purgeable$|^File-backed pages$/ { c += $2 }
            /^Pages free$/ { f += $2 }
            END { if (u + f) printf "%d\n", 1000 * (u - c) / (u + f) + 0.5 }')
    fi
}

# Sets REPLY to "percent status" with status one of charged, charging,
# discharging, attached or unknown, or to nothing without a battery.
battery_state() {
    REPLY=
    if [[ -d /sys/class/power_supply ]]; then
        local dir type cap st
        for dir in /sys/class/power_supply/*; do
            read -r type 2>/dev/null <"$dir/type" && [[ "$type" == Battery ]] || continue
            read -r cap 2>/dev/null <"$dir/capacity" || continue
            read -r st 2>/dev/null <"$dir/status"
            case "$st" in
                Full) st=charged ;;
                Charging) st=charging ;;
                Discharging) st=discharging ;;
                "Not charging") st=attached ;;
                *) st=unknown ;;
            esac
            REPLY="$cap $st"
            return
        done
    elif command -v pmset >/dev/null; then
        REPLY=$(pmset -g batt 2>/dev/null | awk -F '; *' 'NR == 2 && /%/ {
            p = $1; sub(/%.*/, "", p); sub(/.*[^0-9]/, "", p)
            s = $2
            if (s ~ /^(charged|finishing charge)/) s = "charged"
            else if (s ~ /^charging/) s = "charging"
            else if (s ~ /^discharging/) s = "discharging"
            else if (s ~ /attached/) s = "attached"
            else s = "unknown"
            print p, s }')
    fi
}

# Whether the process runs `ollama serve`.
ollama_serve() {
    local cmd arg
    { IFS= read -r -d '' cmd && IFS= read -r -d '' arg; } 2>/dev/null <"$PROC/$1/cmdline" &&
        [[ "$cmd" == ollama || "$cmd" == */ollama ]] && [[ "$arg" == serve ]]
}

# Sets REPLY to "pid KiB" for the local Ollama daemon and its descendants,
# including current `ollama runner` and older llama-server runners, or to
# nothing when it is not running.
ollama_pid=
ollama_usage() {
    REPLY=
    if [[ -n "$LINUX" ]]; then
        local dir pid all i=0 kids task rss _ total=0
        if [[ -z "$ollama_pid" ]] || ! ollama_serve "$ollama_pid"; then
            ollama_pid=
            for dir in "$PROC"/[0-9]*; do
                ollama_serve "${dir##*/}" && ollama_pid=${dir##*/} && break
            done
            [[ -n "$ollama_pid" ]] || return
        fi
        [[ -n "$page_kib" ]] || page_kib=$(($(getconf PAGESIZE 2>/dev/null || echo 4096) / 1024))
        all=("$ollama_pid")
        while ((i < ${#all[@]})); do
            pid=${all[i]} i=$((i + 1))
            read -r _ rss _ 2>/dev/null <"$PROC/$pid/statm" && total=$((total + rss))
            for task in "$PROC/$pid/task/"*/children; do
                kids=()
                read -r -a kids 2>/dev/null <"$task"
                all+=("${kids[@]}")
            done
        done
        REPLY="$ollama_pid $((total * page_kib))"
    else
        # One snapshot avoids races between pgrep and ps.
        REPLY=$(ps -axo pid=,ppid=,rss=,args= 2>/dev/null | awk '
            {parent[$1]=$2; rss[$1]=$3}
            !server && $4 ~ /(^|\/)ollama$/ && $5 == "serve" {server=$1}
            END {
                if (!server) exit
                child[server]=1
                do {
                    changed=0
                    for (pid in parent) if (!child[pid] && child[parent[pid]]) {
                        child[pid]=1; changed=1
                    }
                } while (changed)
                for (pid in child) if (child[pid]) total+=rss[pid]
                print server, total
            }')
    fi
}

# Sets ollama_models to the models the server has loaded. A slow or failed
# request keeps the models last seen from this server.
ollama_seen='' ollama_models=''
ollama_models() {
    local json
    if json=$(curl -fsS --max-time 1 http://localhost:11434/api/ps 2>/dev/null) &&
        ollama_models=$(jq -r '[.models[]?.name] | join(", ")' <<<"$json" 2>/dev/null); then
        [[ "$1 $ollama_models" == "$ollama_seen" ]] && return
        ollama_seen="$1 $ollama_models"
        save ollama_models "$ollama_seen"
    else
        [[ -n "$ollama_seen" ]] || { load ollama_models; ollama_seen=$REPLY; }
        ollama_models=
        [[ "$ollama_seen" == "$1 "* ]] && ollama_models=${ollama_seen#"$1 "}
    fi
}

seg_ram() {
    ram_usage
    [[ -n "$REPLY" ]] && ram_last=$REPLY
    pct "${ram_last:-0}"
    out+="#[fg=#{@thm_surface_0},bg=#{@thm_flamingo}]#[reverse]$SEP#[noreverse]#[fg=#{@thm_crust}]󱀙 "
    out+="#[fg=#{@thm_fg},bg=#{@thm_surface_0}] $REPLY "
}

seg_cpu() {
    local fg="#{@thm_fg}" bg="#{@thm_surface_0}"
    cpu_usage
    [[ -n "$REPLY" ]] && cpu_last=$REPLY
    ((${cpu_last:-0} >= 800)) && fg="#{@thm_crust}" bg="#{@thm_red}"
    pct "${cpu_last:-0}"
    out+="#[fg=#{@thm_yellow}]$SEP#[fg=#{@thm_crust},bg=#{@thm_yellow}] "
    out+="#[fg=$fg,bg=$bg] $REPLY#[fg=$bg]$SEP"
}

seg_battery() {
    local cap st icon
    battery_state
    [[ -n "$REPLY" ]] || return
    read -r cap st <<<"$REPLY"
    case "$st" in
        charged) icon=󰚥 ;;
        charging) icon=󰂄 ;;
        attached) icon=󱈑 ;;
        discharging)
            if ((cap >= 95)); then icon=󰁹
            elif ((cap >= 80)); then icon=󰂁
            elif ((cap >= 65)); then icon=󰁿
            elif ((cap >= 50)); then icon=󰁾
            elif ((cap >= 35)); then icon=󰁽
            elif ((cap >= 20)); then icon=󰁼
            elif ((cap > 5)); then icon=󰁻
            else icon=󰁺
            fi ;;
        *) icon=󰂑 ;;
    esac
    printf -v cap '%3d%%' "$cap"
    out+="#[fg=#{@thm_lavender}]$SEP#[fg=#{@thm_crust},bg=#{@thm_lavender}]$icon "
    out+="#[fg=#{@thm_fg},bg=#{@thm_surface_0}] $cap#[fg=#{@thm_surface_0}]$SEP"
}

# Local Ollama daemon, its memory and loaded models; with an argument, the
# models are those last fetched.
seg_ollama() {
    local BG="#4f8a8a" pid kib size
    ollama_usage
    read -r pid kib <<<"$REPLY"
    ollama_up=$pid
    out+="#[fg=#{@thm_surface_0},bg=$BG]#[reverse]$SEP#[noreverse]#[fg=#{@thm_fg}]🦙 "
    if [[ -z "$pid" ]]; then
        out+="#[fg=#{@thm_red},bg=#{@thm_surface_0}] ● "
        return
    fi
    if ((kib >= 1048576)); then
        size=$(((kib * 10 + 524288) / 1048576))
        printf -v size '%2d.%dGiB' $((size / 10)) $((size % 10))
    else
        printf -v size '%4dMiB' $(((kib + 512) / 1024))
    fi
    out+="#[fg=#{@thm_green},bg=#{@thm_surface_0}] ● #[fg=#{@thm_fg}]id$pid $size"
    [[ -n "$1" ]] || ollama_models "$pid"
    [[ -n "$ollama_models" ]] && out+=" $ollama_models"
    out+=" "
}

# Sets REPLY to the branch checked out in the repository containing $1, as
# `git rev-parse --abbrev-ref HEAD` prints it, without starting git.
git_branch() {
    local dir=$1 git head
    REPLY=
    while [[ ! -e "$dir/.git" ]]; do
        [[ -n "$dir" ]] || return
        dir=${dir%/*}
    done
    git=$dir/.git
    if [[ -f "$git" ]]; then
        # Worktrees and submodules point to their git directory.
        read -r head 2>/dev/null <"$git" && [[ "$head" == "gitdir: "* ]] || return
        git=${head#gitdir: }
        [[ "$git" == /* ]] || git=$dir/$git
    fi
    read -r head 2>/dev/null <"$git/HEAD" || return
    case "$head" in
        # Reftable repositories keep the real HEAD elsewhere.
        "ref: refs/heads/.invalid") REPLY=$(git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null) ;;
        "ref: refs/heads/"*) REPLY=${head#ref: refs/heads/} ;;
        "ref: "*) REPLY=${head#ref: } ;;
        *) REPLY=HEAD ;;
    esac
}

# Sets a hidden environment variable status-right reads when it changed, and
# redraws the status line of each client. Fails only when the server is gone.
clients=()
publish() {
    local cmds=() c
    while (($#)); do
        cmds+=(setenv -gh "$1" "$2" \;)
        shift 2
    done
    for c in "${clients[@]}"; do cmds+=(refresh-client -S -t "$c" \;); done
    # A client that detached since the listing only fails its own refresh.
    tmux "${cmds[@]}" >/dev/null 2>&1 || [[ -z "$server" ]] || kill -0 "$server" 2>/dev/null
}

list_clients() {
    local c list
    list=$(tmux list-clients -F '#{client_name}') || return 1
    clients=()
    while read -r c; do [[ -n "$c" ]] && clients+=("$c"); done <<<"$list"
    return 0
}

prev_stats=-
update_fast() {
    local stats
    out=; seg_ram; seg_cpu
    stats=$out
    [[ "$stats" == "$prev_stats" ]] && return 0
    publish TMUX_STATUS_STATS "$stats" || return 1
    prev_stats=$stats
}

# Continuum puts its save job at the front of status-right when it is the only
# tmux server; the watcher runs it instead, so nothing forks inside the status line.
CONTINUUM_JOB='#\(([^)]*/continuum_save\.sh)\)'
prev_ollama=- prev_battery=- continuum_due=0 battery_due=0 models_due=0 ollama_due=0

# Each pane's @pane_branch, the ollama and battery segments and continuum's
# save, each when due; with an argument, everything now.
update_slow() {
    local now=$SECONDS lines line sr continuum id cur path ollama env=() cmds=() pane_cmds=()
    [[ -n "$1" ]] && continuum_due=0 battery_due=0 models_due=0 ollama_due=0
    lines=$(tmux show -gv status-right \; display -p '#{@status_continuum}' \; \
        list-clients -F "C#{client_name}" \; \
        list-panes -a -F "P#{pane_id}$TAB#{pane_current_path}$TAB#{@pane_branch}") || return 1
    {
        read -r sr
        read -r continuum
        clients=()
        while IFS= read -r line; do
            case "$line" in
                C*) clients+=("${line#C}") ;;
                P*)
                    IFS=$TAB read -r id path cur <<<"${line#P}"
                    git_branch "$path"
                    [[ "$REPLY" == "$cur" ]] && continue
                    if [[ -n "$REPLY" ]]; then
                        pane_cmds+=(set -p -t "$id" @pane_branch "$REPLY" \;)
                    else
                        pane_cmds+=(set -pu -t "$id" @pane_branch \;)
                    fi ;;
            esac
        done
    } <<<"$lines"
    if [[ "$sr" =~ $CONTINUUM_JOB ]]; then
        continuum=${BASH_REMATCH[1]}
        cmds+=(set -g @status_continuum "$continuum" \; set -g status-right "${sr/"${BASH_REMATCH[0]}"/}" \;)
    fi
    # Panes last: one closed since the listing stops the rest of the list.
    cmds+=("${pane_cmds[@]}")
    ((${#cmds[@]} == 0)) || tmux "${cmds[@]}" >/dev/null 2>&1

    if ((now >= ollama_due)); then
        out=
        if ((now >= models_due)); then
            seg_ollama
            models_due=$((now + 5))
        else
            seg_ollama cached
        fi
        ollama=$out
        # Looking for a server that is not running reads every process.
        if [[ -n "$ollama_up" ]]; then ollama_due=$((now + 2)); else ollama_due=$((now + 10)); fi
        [[ "$ollama" == "$prev_ollama" ]] || env+=(TMUX_STATUS_OLLAMA "$ollama")
        prev_ollama=$ollama
    fi
    if ((now >= battery_due)); then
        out=; seg_battery
        battery_due=$((now + 15))
        [[ "$out" == "$prev_battery" ]] || env+=(TMUX_STATUS_BATTERY "$out")
        prev_battery=$out
    fi
    ((${#env[@]} == 0)) || publish "${env[@]}" || return 1
    if [[ -n "$continuum" ]] && ((now >= continuum_due)); then
        # It saves every @continuum-save-interval minutes and checks only that.
        "$continuum"
        continuum_due=$((now + 60))
    fi
    return 0
}

update() {
    update_slow all && update_fast
}

# Whether this watcher is still the one the server should run.
current() {
    load "watch-$server"
    [[ "$REPLY" == "$token" ]] && kill -0 "$server" 2>/dev/null
}

watch() {
    local fifo token
    server=${TMUX#*,}
    server=${server%%,*}
    [[ -n "$server" ]] || { echo "tmux-status watch: run it from tmux" >&2; exit 2; }
    # run -b shows a job's output, and reports a killed one. A config reload
    # starts a new watcher, so the previous one exits at its next pass instead.
    exec >/dev/null 2>&1
    fifo="$STATE/nap.$$"
    mkfifo -m 600 "$fifo" && exec 3<>"$fifo" && nap_fd=3
    rm -f "$fifo"
    token=$$
    save "watch-$server" "$token"
    update_slow all || exit
    (while nap 2 && current && update_slow; do :; done) &
    list_clients || exit
    local pass=0
    while current && update_fast; do
        nap "$FAST"
        # Clients that attach later get their status line redrawn by
        # status-interval until the next listing.
        ((++pass % 8)) || list_clients || break
    done
    wait
}

case "$1" in
    watch) watch; exit ;;
    update) list_clients && update; exit ;;
esac
out=
for seg in "$@"; do
    case "$seg" in
        ollama | ram | cpu | battery) "seg_$seg" ;;
        *) echo "usage: tmux-status watch | update | [ollama|ram|cpu|battery]..." >&2; exit 2 ;;
    esac
done
printf '%s\n' "$out"
