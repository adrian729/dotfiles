#!/usr/bin/env bash

# ── AI usage status for tmux — shows Claude (brain icon) + OpenCode (star_cog icon)
# Called by tmux via #() in status-right every status-interval (1s).
# Claude data from $CACHE_DIR/statusline-rate-limits (written by claude's statusline.sh).
# OpenCode data from SQLite DB, cached to $CACHE_DIR/tmux-opencode-cache (60s stale → bg refresh).

# ── Icons ──
CLAUDE_ICON="󰚩"
OPENCODE_ICON="󱙺"

# ── Colors ──
CLAUDE_BG="#FAB387"
OPENCODE_BG="#CBA6F7"
SURFACE_0="#313244"
CRUST="#11111B"
GREEN="#A6E3A1"
YELLOW="#F9E2AF"
RED="#F38BA8"

# ── Limits ──
WINDOW_5H=18000
WINDOW_7D=604800
LIMIT_5H=12
LIMIT_7D=30
LIMIT_30D=60

# OpenCode's Go-plan monthly cap is a FIXED billing cycle, not a rolling 30-day window — two
# independent "Monthly usage limit reached. Resets in N days" server errors (2026-08-04 and
# 2026-08-06, both counting down to 2026-08-10) confirm a per-account reset anchored to a
# calendar day-of-month. No local file or `opencode` CLI command exposes this day, so it's
# hardcoded from that observation; if OpenCode ever changes the account's reset day, update it.
RESET_DAY_OF_MONTH=10

# Shared with claude/.claude/statusline.sh, which writes CLAUDE_CACHE — keep paths in sync.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ai-status"
mkdir -p -m 700 "$CACHE_DIR"
chmod 700 "$CACHE_DIR" 2>/dev/null

CACHE_MAX_AGE=10
LOCK_MAX_AGE=60
CLAUDE_CACHE="$CACHE_DIR/statusline-rate-limits"
CLAUDE_WEEKLY_LOG="$HOME/.local/share/claude/weekly-usage.log"
OPENCODE_CACHE="$CACHE_DIR/tmux-opencode-cache"
OPENCODE_DB="$HOME/.local/share/opencode/opencode.db"
LOCK_DIR="$CACHE_DIR/tmux-opencode-refresh.lock"
LOCK_PID_FILE="$LOCK_DIR.pid"

NOW=$(date +%s)

# ── Current OpenCode billing-cycle start (most recent RESET_DAY_OF_MONTH, UTC midnight) ──
cur_day=$((10#$(date -u +%d)))
cur_month=$((10#$(date -u +%m)))
cur_year=$(date -u +%Y)
if (( cur_day >= RESET_DAY_OF_MONTH )); then
    cycle_year=$cur_year; cycle_month=$cur_month
elif (( cur_month == 1 )); then
    cycle_year=$((cur_year - 1)); cycle_month=12
else
    cycle_year=$cur_year; cycle_month=$((cur_month - 1))
fi
cycle_date=$(printf '%04d-%02d-%02d 00:00:00' "$cycle_year" "$cycle_month" "$RESET_DAY_OF_MONTH")
CYCLE_START=$(date -u -j -f '%Y-%m-%d %H:%M:%S' "$cycle_date" +%s 2>/dev/null || date -u -d "$cycle_date" +%s 2>/dev/null || echo 0)

# ── Percent formatting ──
fmt_pct() {
    local raw=$1 v
    [[ ! "$raw" =~ ^[0-9]+\.?[0-9]*$ ]] && { printf '0%%'; return; }
    v=$(printf "%.1f" "$raw" 2>/dev/null)
    if   (( $(echo "$v < 1" | bc -l) ))  2>/dev/null; then printf '0%%'
    elif (( $(echo "$v < 10" | bc -l) )) 2>/dev/null; then printf '%.1f%%' "$v"
    else printf '%.0f%%' "$v"
    fi
}

# ── Color: hard-cap thresholds (OpenCode — no reset epoch available) ──
threshold_color() {
    local used=$1
    [[ ! "$used" =~ ^[0-9]+\.?[0-9]*$ ]] && { printf '%s' "$GREEN"; return; }
    if   (( $(echo "$used > 80" | bc -l) )) 2>/dev/null; then printf '%s' "$RED"
    elif (( $(echo "$used > 50" | bc -l) )) 2>/dev/null; then printf '%s' "$YELLOW"
    else printf '%s' "$GREEN"
    fi
}

# ── Color: pace-aware (Claude — compares burn rate to elapsed window time) ──
pace_color() {
    local used=$1 reset=$2 win=$3 color="$GREEN" left elapsed over
    (( win <= 0 )) && win=1
    [[ ! "$used" =~ ^[0-9]+\.?[0-9]*$ ]] && { printf '%s' "$GREEN"; return; }
    if [[ "$reset" -gt 0 ]] 2>/dev/null; then
        left=$(( reset - NOW ))
        (( left < 0 )) && left=0
        elapsed=$(( (win - left) * 100 / win ))
        (( elapsed < 0 )) && elapsed=0
        (( elapsed > 100 )) && elapsed=100
        over=$(echo "$used - $elapsed" | bc -l)
        if   (( $(echo "$over >= 20" | bc -l) )) 2>/dev/null; then printf '%s' "$RED"; return
        elif (( $(echo "$over > 0"   | bc -l) )) 2>/dev/null; then printf '%s' "$YELLOW"; return
        fi
    fi
    if   (( $(echo "$used > 80" | bc -l) )) 2>/dev/null; then printf '%s' "$RED"
    elif (( $(echo "$used > 50" | bc -l) )) 2>/dev/null && [[ "$color" = "$GREEN" ]]; then printf '%s' "$YELLOW"
    else printf '%s' "$GREEN"
    fi
}

# ── Pill segment: bg hex, icon, left_bg, color1, val1, [color2, val2, ...] ──
# left_bg is the arc fill color (previous segment's bg) for seamless transitions
# Each value gets its own color via #[fg=...]
pill() {
    local bg=$1 icon=$2 left_bg=${3:-$CRUST}
    shift 3
    printf '#[fg=%s,bg=%s]#[reverse]#[noreverse]#[fg=%s]%s ' "$left_bg" "$bg" "$CRUST" "$icon"
    local sep=""
    while [[ $# -ge 2 ]]; do
        printf '#[fg=%s,bg=%s] %s%s' "$1" "$SURFACE_0" "$sep" "$2"
        sep="| "
        shift 2
    done
    printf ' '
}

# ── Refresh OpenCode cache (background, mkdir-locked) ──
refresh_opencode_cache() {
    # A refresh process that died mid-run leaves LOCK_DIR behind forever. Reap it only
    # once its pid is confirmed dead (age alone can't tell "dead" from "just slow" and
    # would otherwise let a concurrent invocation steal the lock from a live refresh).
    if [ -d "$LOCK_DIR" ]; then
        lock_pid=$(cat "$LOCK_PID_FILE" 2>/dev/null)
        if [ -z "$lock_pid" ] || ! kill -0 "$lock_pid" 2>/dev/null; then
            lock_age=$(( $(date +%s) - $(stat -f %m "$LOCK_DIR" 2>/dev/null || stat -c %Y "$LOCK_DIR" 2>/dev/null || echo "$NOW") ))
            [ "$lock_age" -gt "$LOCK_MAX_AGE" ] && { rmdir "$LOCK_DIR" 2>/dev/null; rm -f "$LOCK_PID_FILE"; }
        fi
    fi
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        (
            local cost_5h cost_7d cost_30d ts
            if [[ -f "$OPENCODE_DB" ]]; then
                # Per-message, not per-session: session.model only holds the LAST model used,
                # so a session that starts on opencode-go and gets rate-limit-fallen-back to a
                # free model (model-fallback.js) would have its whole cost mistagged as free and
                # silently dropped from the Go-plan budget. message.data carries the provider and
                # timestamp actually billed for that message, so it survives mid-session fallback.
                cost_5h=$(sqlite3 "$OPENCODE_DB" \
                    "SELECT COALESCE(SUM(json_extract(data, '\$.cost')), 0) FROM message
                     WHERE time_created > (unixepoch('now') - $WINDOW_5H) * 1000
                     AND json_extract(data, '\$.providerID') = 'opencode-go'" 2>/dev/null) || cost_5h=0
                cost_7d=$(sqlite3 "$OPENCODE_DB" \
                    "SELECT COALESCE(SUM(json_extract(data, '\$.cost')), 0) FROM message
                     WHERE time_created > (unixepoch('now') - $WINDOW_7D) * 1000
                     AND json_extract(data, '\$.providerID') = 'opencode-go'" 2>/dev/null) || cost_7d=0
                cost_30d=$(sqlite3 "$OPENCODE_DB" \
                    "SELECT COALESCE(SUM(json_extract(data, '\$.cost')), 0) FROM message
                     WHERE time_created > $CYCLE_START * 1000
                     AND json_extract(data, '\$.providerID') = 'opencode-go'" 2>/dev/null) || cost_30d=0
            else
                cost_5h=0; cost_7d=0; cost_30d=0
            fi
            ts=$(date +%s)
            tmp=$(mktemp "${OPENCODE_CACHE}.XXXXXX") && \
                printf '{"cost_5h":%s,"cost_7d":%s,"cost_30d":%s,"ts":%s}\n' \
                "$cost_5h" "$cost_7d" "$cost_30d" "$ts" > "$tmp" && \
                mv -f "$tmp" "$OPENCODE_CACHE"
            rm -f "$LOCK_PID_FILE"
            rmdir "$LOCK_DIR"
        ) &
        echo $! > "$LOCK_PID_FILE"
    fi
}

# ── Read OpenCode cache, trigger bg refresh if stale ──
read_opencode() {
    local stale=1 o_ts
    if [[ -f "$OPENCODE_CACHE" ]]; then
        o_ts=$(jq -r '.ts // 0' "$OPENCODE_CACHE" 2>/dev/null)
        [[ "$o_ts" -gt $((NOW - CACHE_MAX_AGE)) ]] 2>/dev/null && stale=0
    fi
    [[ "$stale" -eq 1 ]] && refresh_opencode_cache
    if [[ -f "$OPENCODE_CACHE" ]]; then
        o_cost_5h=$(jq -r '.cost_5h // 0'  "$OPENCODE_CACHE" 2>/dev/null) || o_cost_5h=0
        o_cost_7d=$(jq -r '.cost_7d // 0'  "$OPENCODE_CACHE" 2>/dev/null) || o_cost_7d=0
        o_cost_30d=$(jq -r '.cost_30d // 0' "$OPENCODE_CACHE" 2>/dev/null) || o_cost_30d=0
    fi
    : "${o_cost_5h:=0}" "${o_cost_7d:=0}" "${o_cost_30d:=0}"
}

# ── Read Claude cache ──
read_claude() {
    c_5h_pct=0; c_7d_pct=0; c_5h_reset=0; c_7d_reset=0; c_monthly_pct=0
    if [[ -f "$CLAUDE_CACHE" ]]; then
        IFS='|' read -r c_5h_pct c_7d_pct c_5h_reset c_7d_reset < "$CLAUDE_CACHE" 2>/dev/null
    fi
    : "${c_5h_pct:=0}" "${c_7d_pct:=0}" "${c_5h_reset:=0}" "${c_7d_reset:=0}"
    # "Monthly" = % of a synthetic 4-week budget (Anthropic exposes no monthly window, so
    # monthly budget := 4x weekly budget). Divisor is ALWAYS 4, deliberately NOT the count
    # of weeks actually logged: a week missing from the log (not yet accumulated, or predates
    # this feature) correctly floors to 0% of ITS share of the budget — it's not "unknown
    # data to average around". This understates monthly until 3 prior weeks have logged
    # (expected during the first ~3 weeks after this feature ships or after log loss), then
    # self-corrects into a real trailing 4-week %. Do not change the divisor to (weeks found
    # + 1) — that swaps the metric to "average weekly pace", which reads as monthly≈weekly
    # for that entire bootstrap period instead of ramping up.
    local weeks_logged_sum=0 pct
    if [[ -f "$CLAUDE_WEEKLY_LOG" ]]; then
        while IFS='|' read -r _ pct _; do
            [[ "$pct" =~ ^[0-9]+\.?[0-9]*$ ]] && weeks_logged_sum=$(echo "$weeks_logged_sum + $pct" | bc -l 2>/dev/null)
        done < <(tail -3 "$CLAUDE_WEEKLY_LOG" 2>/dev/null)
    fi
    c_monthly_pct=$(echo "scale=2; ($c_7d_pct + $weeks_logged_sum) / 4" | bc -l 2>/dev/null) || c_monthly_pct=0
}

# ── Main ──
read_claude
read_opencode

# OpenCode percentages (multiply first to avoid bc scale truncation)
o_5h_pct=$( echo "scale=4; ${o_cost_5h:-0} * 100 / $LIMIT_5H"  | bc -l 2>/dev/null) || o_5h_pct=0
o_7d_pct=$( echo "scale=4; ${o_cost_7d:-0} * 100 / $LIMIT_7D"  | bc -l 2>/dev/null) || o_7d_pct=0
o_30d_pct=$(echo "scale=4; ${o_cost_30d:-0} * 100 / $LIMIT_30D" | bc -l 2>/dev/null) || o_30d_pct=0

# Colors
c_5h_color=$(pace_color "$c_5h_pct" "$c_5h_reset" "$WINDOW_5H")
c_7d_color=$(pace_color "$c_7d_pct" "$c_7d_reset" "$WINDOW_7D")
c_monthly_color=$(threshold_color "$c_monthly_pct")

o_5h_color=$(threshold_color "$o_5h_pct")
o_7d_color=$(threshold_color "$o_7d_pct")
o_30d_color=$(threshold_color "$o_30d_pct")

# Format values
c_5h_fmt=$(fmt_pct "$c_5h_pct")
c_7d_fmt=$(fmt_pct "$c_7d_pct")
c_monthly_fmt=$(fmt_pct "$c_monthly_pct")
o_5h_fmt=$(fmt_pct "$o_5h_pct")
o_7d_fmt=$(fmt_pct "$o_7d_pct")
o_30d_fmt=$(fmt_pct "$o_30d_pct")

# Render two pills
pill "$CLAUDE_BG"   "$CLAUDE_ICON"   "$CRUST"     "$c_5h_color" "$c_5h_fmt" "$c_7d_color" "$c_7d_fmt" "$c_monthly_color" "$c_monthly_fmt"
pill "$OPENCODE_BG" "$OPENCODE_ICON" "$SURFACE_0" "$o_5h_color" "$o_5h_fmt" "$o_7d_color" "$o_7d_fmt" "$o_30d_color" "$o_30d_fmt"
