#!/usr/bin/env bash
# Local Ollama daemon and descendant RSS; refreshed by tmux's status interval.
ICON="🦙"
BG="#4f8a8a"
SURFACE_0="#313244"
FG="#cdd6f4"
GREEN="#A6E3A1"
RED="#F38BA8"

# One snapshot avoids races between pgrep and ps. Count only this server's
# descendants, including current `ollama runner` and older llama-server runners.
read -r PID RSS < <(ps -axo pid=,ppid=,rss=,args= 2>/dev/null | awk '
    {parent[$1]=$2; rss[$1]=$3}
    !server && $4 ~ /(^|\/)ollama$/ && $5 == "serve" {server=$1}
    END {
        if (!server) exit
        child[server]=1
        do {
            changed=0
            for (pid in parent) if (!child[pid] && child[parent[pid]]) {
                child[pid]=1; changed=1
            }
        } while (changed)
        for (pid in child) if (child[pid]) total+=rss[pid]
        print server, total
    }')
printf '#[fg=%s,bg=%s]#[reverse]#[noreverse]#[fg=%s]%s ' "$SURFACE_0" "$BG" "$FG" "$ICON"
if [[ -z "$PID" ]]; then
    printf '#[fg=%s,bg=%s] ● ' "$RED" "$SURFACE_0"
    exit 0
fi
printf '#[fg=%s,bg=%s] ● ' "$GREEN" "$SURFACE_0"
printf '#[fg=%s,bg=%s]id%s' "$FG" "$SURFACE_0" "$PID"
mem=$(awk -v n="$RSS" 'BEGIN {if (n>=1048576) printf "%.1fGiB", n/1048576; else printf "%.0fMiB", n/1024}')
printf '#[fg=%s,bg=%s] %s' "$FG" "$SURFACE_0" "$mem"
MODEL=$(curl -fsS --max-time 0.3 http://localhost:11434/api/ps 2>/dev/null |
    jq -r '[.models[]?.name] | join(", ")' 2>/dev/null)
if [[ -n "$MODEL" ]]; then
    printf '#[fg=%s,bg=%s] %s' "$FG" "$SURFACE_0" "$MODEL"
fi
printf ' '
