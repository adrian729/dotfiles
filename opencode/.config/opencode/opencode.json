{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "server": {
    "port": 42069
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {}
    }
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow"
    }
  },
  "agent": {
    "relay": {
      "description": "Text-only relay: answer from the given text alone, no tools.",
      "mode": "primary",
      "hidden": true,
      "permission": {
        "*": "deny"
      },
      "prompt": "You are a text-only relay. Answer the request using only the text given to you in the message. You have no tools and no file, repo, or web access \u2014 never claim to check or fetch anything, just answer directly."
    },
    "task": {
      "description": "Coding agent for headless runs via opencode-task. Denies external-directory tool requests; shell commands are not sandboxed.",
      "mode": "primary",
      "hidden": true,
      "permission": {
        "external_directory": "deny"
      }
    }
  },
  "lsp": {
    "lua-ls": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ],
      "initialization": {
        "runtime": {
          "version": "LuaJIT"
        },
        "workspace": {
          "checkThirdParty": false
        }
      }
    },
    "marksman": {
      "command": [
        "marksman"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    }
  }
}
