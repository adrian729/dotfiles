#!/usr/bin/env bash
# Resolve exact configured free IDs against the catalog. No inference requests.
set -euo pipefail
STATE_DIR="$HOME/.local/state/agents"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode-models.json"
[ -f "$CONFIG_FILE" ] || CONFIG_FILE="$HOME/.local/config/opencode-models.json"
if [ ! -f "$CONFIG_FILE" ]; then
  SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  CONFIG_FILE="$SELF_DIR/../config/opencode-models.json"
fi
die() { echo "opencode-agent-models-probe: $*" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || die "jq is required"
jq -e '
  (.free_models | type == "array" and length > 0 and all(.[]; type == "string" and startswith("opencode/"))) and
  (.agents | type == "object" and length > 0 and all(.[]; type == "array" and all(.[]; type == "string")))
' "$CONFIG_FILE" >/dev/null || die "invalid model configuration: $CONFIG_FILE"

catalog=""
if ! catalog=$(opencode models opencode 2>/dev/null); then
  echo "opencode-agent-models-probe: catalog unavailable; pins below are unverified" >&2
  catalog=""
fi
available=$(printf '%s\n' "$catalog" | jq -Rsc 'split("\n") | map(select(test("^opencode/[^[:space:]]+$"))) | unique')
# If a model rotates out, keep an explicit configured free pin. It may fail to
# load until the list is refreshed, but never silently inherits a paid default.
resolved=$(jq --argjson available "$available" '
  . as $cfg | [.agents | to_entries[] |
    .key as $name | [.value[] | select(. as $m | $cfg.free_models | index($m))] as $free |
    ([$free[] | select(. as $m | $available | index($m))][0]) as $live |
    if ($free | length) == 0 then error("no configured free model for " + $name)
    else {name: $name, model: ($live // $free[0]), verified: ($live != null)} end]
' "$CONFIG_FILE") || die "every agent needs at least one configured free model"
unverified=$(printf '%s\n' "$resolved" | jq -r '[.[] | select(.verified | not) | .name] | join(", ")')
stale=$(jq -r --argjson available "$available" '[.free_models[] | select(. as $m | $available | index($m) | not)] | join(", ")' "$CONFIG_FILE")
[ -z "$stale" ] || echo "opencode-agent-models-probe: configured but not listed: $stale" >&2
note=""
if [ -n "$unverified" ]; then
  note="unverified free pins: $unverified; refresh the model lists before use"
  echo "opencode-agent-models-probe: $note" >&2
fi
mkdir -p "$STATE_DIR"
state_tmp=$(mktemp "$STATE_DIR/opencode-agent-models.XXXXXX")
overrides_tmp=$(mktemp "$STATE_DIR/opencode-agent-overrides.XXXXXX")
trap 'rm -f "$state_tmp" "$overrides_tmp"' EXIT
printf '%s\n' "$resolved" | jq '{agent: (map({key: .name, value: {model: .model}}) | from_entries)}' > "$overrides_tmp"
jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg note "$note" --argjson available "$available" --slurpfile overrides "$overrides_tmp" \
  '{probed_at: $at, available: $available, agent_overrides: $overrides[0], note: (if $note == "" then null else $note end)}' > "$state_tmp"
mv -f "$overrides_tmp" "$STATE_DIR/opencode-agent-model-overrides.json"
mv -f "$state_tmp" "$STATE_DIR/opencode-agent-models.json"
echo "opencode-agent-models: $(printf '%s\n' "$resolved" | jq length) agents pinned to configured free models"
[ -z "$unverified" ]
