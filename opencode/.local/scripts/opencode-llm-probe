#!/usr/bin/env bash
# Filter the configured relay order against the catalog; no inference requests.
set -euo pipefail
STATE_DIR="$HOME/.local/state/agents"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode-models.json"
[ -f "$CONFIG_FILE" ] || CONFIG_FILE="$HOME/.local/config/opencode-models.json"
if [ ! -f "$CONFIG_FILE" ]; then
  SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  CONFIG_FILE="$SELF_DIR/../config/opencode-models.json"
fi
die() { echo "opencode-llm-probe: $*" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || die "jq is required"
preferred=$(jq -ce '. as $cfg | [.relay[] | select(type == "string") | select(. as $m | $cfg.free_models | index($m))] | select(length > 0)' "$CONFIG_FILE") || die "no configured free relay models"
catalog=""
if ! catalog=$(opencode models opencode 2>/dev/null); then catalog=""; fi
available=$(printf '%s\n' "$catalog" | jq -Rsc 'split("\n") | map(select(test("^opencode/[^[:space:]]+$")))')
models=$(jq -n --argjson preferred "$preferred" --argjson available "$available" '$preferred | map(select(. as $m | $available | index($m)))')
count=$(printf '%s\n' "$models" | jq length)
note="catalog checked; this does not test whether requests complete"
if [ "$count" -eq 0 ]; then
  note="no configured free relay model could be verified; wrapper will try the configured free list"
  echo "opencode-llm-probe: $note" >&2
fi
mkdir -p "$STATE_DIR"
tmp=$(mktemp "$STATE_DIR/opencode-llm.XXXXXX")
trap 'rm -f "$tmp"' EXIT
jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg note "$note" --argjson models "$models" \
  '{probed_at: $at, models: $models, note: $note}' > "$tmp"
mv -f "$tmp" "$STATE_DIR/opencode-llm.json"
echo "opencode-llm-models: $count listed free relay models"
[ "$count" -gt 0 ]
