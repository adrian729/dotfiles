#!/usr/bin/env bash
# Record locally pulled models. Failed queries preserve the previous catalog.
set -euo pipefail
STATE_DIR="$HOME/.local/state/agents"
OUT_FILE="$STATE_DIR/opencode-ollama-models.json"
die() { echo "opencode-ollama-models-probe: $*" >&2; exit 1; }
command -v curl >/dev/null 2>&1 || die "curl is required"
command -v jq >/dev/null 2>&1 || die "jq is required"
HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
case "$HOST" in http://*|https://*) : ;; *) HOST="http://$HOST" ;; esac
TAGS=$(curl -fsS --connect-timeout 3 --max-time 10 "${HOST%/}/api/tags") || die "Ollama unavailable; catalog unchanged"
MODELS_JSON=$(printf '%s\n' "$TAGS" | jq -e '
  if (.models | type) != "array" then error("missing models array")
  elif all(.models[]; (.name | type == "string" and length > 0)) | not then error("invalid model name")
  else [.models[] | .name |
    {key: ., value: {name: (. + " (local)")}}] | from_entries end
') || die "invalid Ollama response; catalog unchanged"
mkdir -p "$STATE_DIR"
tmp=$(mktemp "$STATE_DIR/opencode-ollama-models.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$MODELS_JSON" > "$tmp"
mv -f "$tmp" "$OUT_FILE"
echo "opencode-ollama-models-probe: $(printf '%s\n' "$MODELS_JSON" | jq length) local model(s) found"
