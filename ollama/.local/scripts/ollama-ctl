#!/usr/bin/env bash
# ollama-ctl — manage ollama as a background service.
#
# The service manager differs per platform, so every operation goes through the
# svc_* indirection below: macOS installs ollama from Homebrew and supervises it
# with `brew services`, while Linux installs it from ollama.com's own script,
# which registers a systemd unit and logs to the journal.

SERVICE="ollama"

case "$(uname -s)" in
    Darwin) PLATFORM=macos ;;
    *)      PLATFORM=linux ;;
esac

usage() {
    cat <<EOF
Usage: ollama-ctl [COMMAND]

Manage ollama as a background service ($( [ "$PLATFORM" = macos ] && echo "brew services" || echo "systemd" )).

Commands:
  (no arg)  Show status: running/stopped, PID, RSS, loaded model
  start     Start ollama in the background
  stop      Stop the ollama background service
  restart   Stop then start
  log       Tail the ollama log
  -h, --help  Show this help message
EOF
    exit 0
}

# --- platform service backends ----------------------------------------------

if [ "$PLATFORM" = macos ]; then
    svc_running() { brew services info "$SERVICE" 2>/dev/null | grep -q "Running: true"; }
    svc_start()   { brew services start "$SERVICE"; }
    svc_stop()    { brew services stop "$SERVICE"; }
    svc_log() {
        local prefix log
        prefix=$(brew --prefix 2>/dev/null) || prefix=/usr/local
        log="$prefix/var/log/ollama.log"
        if [ -f "$log" ]; then
            tail -f "$log"
        else
            echo "ollama-ctl: no log at $log" >&2
            return 1
        fi
    }
else
    command -v systemctl >/dev/null 2>&1 ||
        echo "ollama-ctl: systemctl not found — start ollama manually with 'ollama serve'" >&2

    # The ollama.com installer creates a system-wide unit; a manual install may
    # instead have a --user one. Pick whichever this machine actually knows
    # about so start/stop/status all address the same unit.
    if systemctl list-unit-files --user "$SERVICE.service" 2>/dev/null | grep -q "^$SERVICE.service"; then
        SCOPE=(--user)
        SUDO=()
    else
        SCOPE=()
        # Only the state-changing verbs need root. `is-active` and `journalctl`
        # are readable unprivileged, and routing them through sudo would make a
        # bare `ollama-ctl` status check prompt for a password.
        SUDO=(sudo)
    fi
    svc_running() { systemctl "${SCOPE[@]}" is-active --quiet "$SERVICE"; }
    svc_start()   { "${SUDO[@]}" systemctl "${SCOPE[@]}" start "$SERVICE"; }
    svc_stop()    { "${SUDO[@]}" systemctl "${SCOPE[@]}" stop "$SERVICE"; }
    svc_log()     { journalctl "${SCOPE[@]}" -u "$SERVICE" -f; }
fi

status() {
    local pid rss mem model
    if svc_running; then
        pid=$(pgrep -f "ollama serve" | head -1)
        echo "ollama: running"
        if [[ -n "$pid" ]]; then
            rss=$(ps -o rss= -p "$pid" 2>/dev/null)
            if [[ -n "$rss" ]]; then
                if (( rss > 1048576 )); then
                    mem=$(echo "scale=1; $rss / 1048576" | bc -l)"G"
                elif (( rss > 1024 )); then
                    mem=$(echo "scale=0; $rss / 1024" | bc -l)"M"
                else
                    mem="${rss}K"
                fi
            fi
            echo "  PID:  $pid"
            [[ -n "$mem" ]] && echo "  RSS:  $mem"
        fi
        if command -v jq &>/dev/null; then
            model=$(curl -s --max-time 1 http://localhost:11434/api/ps 2>/dev/null | jq -r '.models[0].name // ""' 2>/dev/null)
            [[ -n "$model" ]] && echo "  loaded model: $model"
        fi
    else
        echo "ollama: stopped"
    fi
}

case "${1:-}" in
    -h|--help) usage ;;
    start)
        svc_start
        sleep 1
        status
        ;;
    stop)
        svc_stop
        status
        ;;
    restart)
        svc_stop
        sleep 1
        svc_start
        sleep 1
        status
        ;;
    log)
        svc_log
        ;;
    "")
        status
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'ollama-ctl --help' for usage."
        exit 1
        ;;
esac
