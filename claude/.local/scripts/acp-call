#!/usr/bin/env python3
"""Send newline-delimited ACP requests to AGENT_CMD [TIMEOUT_SECS].

Requests run sequentially; responses and notifications are printed as JSON lines.
A session/new response supplies missing sessionId fields on later session requests.
Prompt text chunks are also collected in the response's result.content (a helper
extension, not an ACP field). Timeout applies to each request, including prompts.
This minimal client does not expose filesystem/terminal tools or grant permissions.
Exit codes: 2 invalid input, 6 protocol/process error, 124 timeout.
"""
import json
import math
import os
import queue
import signal
import subprocess
import sys
import threading
import time


def main():
    if not 2 <= len(sys.argv) <= 3:
        raise ValueError("usage: acp-call AGENT_CMD [TIMEOUT_SECS]")
    timeout = float(sys.argv[2]) if len(sys.argv) == 3 else 30
    if not math.isfinite(timeout) or timeout <= 0:
        raise ValueError("timeout must be positive and finite")
    requests = [json.loads(line) for line in sys.stdin if line.strip()]
    for req in requests:
        if not isinstance(req, dict) or not isinstance(req.get("method"), str):
            raise ValueError("each input line must be a JSON-RPC request or notification")
        if "params" in req and not isinstance(req["params"], dict):
            raise ValueError("ACP params must be an object")
        req.setdefault("jsonrpc", "2.0")
    if not requests:
        return 0
    proc = subprocess.Popen(sys.argv[1], shell=True, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, bufsize=1, start_new_session=True)
    lines = queue.Queue()

    def read_stdout():
        try:
            for line in proc.stdout:
                lines.put(line)
        finally:
            lines.put(None)

    def read_stderr():
        for line in proc.stderr:
            print(line, end="", file=sys.stderr, flush=True)

    def send(value):
        proc.stdin.write(json.dumps(value) + "\n")
        proc.stdin.flush()

    threading.Thread(target=read_stdout, daemon=True).start()
    threading.Thread(target=read_stderr, daemon=True).start()
    session_id = None
    try:
        for req in requests:
            method = req["method"]
            if session_id and method in {"session/prompt", "session/cancel", "session/set_mode",
                                         "session/set_config_option", "session/set_model"}:
                req.setdefault("params", {}).setdefault("sessionId", session_id)
            send(req)
            if "id" not in req:
                continue
            content = []
            deadline = time.monotonic() + timeout
            while True:
                try:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise queue.Empty
                    line = lines.get(timeout=remaining)
                except queue.Empty:
                    print(f"acp-call: {method} timed out after {timeout:g}s", file=sys.stderr)
                    return 124
                if line is None:
                    raise RuntimeError(f"agent closed stdout before responding to {method}")
                msg = json.loads(line)
                if not isinstance(msg, dict):
                    raise RuntimeError("agent sent a non-object message")
                if "params" in msg and not isinstance(msg["params"], dict):
                    raise RuntimeError("agent sent non-object params")
                # Agent-to-client requests use the other direction's id namespace.
                if "method" in msg and "id" in msg:
                    reply = {"jsonrpc": "2.0", "id": msg["id"]}
                    if msg["method"] == "session/request_permission":
                        options = msg.get("params", {}).get("options", [])
                        if not isinstance(options, list):
                            raise RuntimeError("permission options must be an array")
                        reject = next((o["optionId"] for o in options
                                       if isinstance(o, dict) and o.get("kind") == "reject_once"
                                       and isinstance(o.get("optionId"), str)), None)
                        outcome = ({"outcome": "selected", "optionId": reject} if reject
                                   else {"outcome": "cancelled"})
                        reply["result"] = {"outcome": outcome}
                    else:
                        reply["error"] = {"code": -32601, "message": "Client method not supported"}
                    send(reply)
                elif "method" not in msg and msg.get("id") == req["id"]:
                    if "error" in msg:
                        print(json.dumps(msg), flush=True)
                        raise RuntimeError(f"{method}: {msg['error']}")
                    if not isinstance(msg.get("result"), dict):
                        raise RuntimeError(f"{method}: missing object result")
                    if method == "session/new":
                        session_id = msg["result"].get("sessionId")
                    if method == "session/prompt" and content:
                        msg["result"]["content"] = [{"type": "text", "text": "".join(content)}]
                    print(json.dumps(msg), flush=True)
                    break
                elif method == "session/prompt" and msg.get("method") == "session/update":
                    params = msg.get("params", {})
                    update = params.get("update", {})
                    if not isinstance(update, dict):
                        raise RuntimeError("session update must be an object")
                    block = update.get("content", {})
                    if (params.get("sessionId") == req.get("params", {}).get("sessionId")
                            and update.get("sessionUpdate") == "agent_message_chunk"
                            and isinstance(block, dict) and block.get("type") == "text"
                            and isinstance(block.get("text"), str)):
                        content.append(block["text"])
                print(json.dumps(msg), flush=True)
        return 0
    except (RuntimeError, OSError, json.JSONDecodeError) as exc:
        print(f"acp-call: {exc}", file=sys.stderr)
        return 6
    finally:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        # macOS reports EPERM rather than ESRCH once the group leader has exited.
        except (ProcessLookupError, PermissionError):
            pass
        proc.wait()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError) as exc:
        print(f"acp-call: {exc}", file=sys.stderr)
        sys.exit(2)
