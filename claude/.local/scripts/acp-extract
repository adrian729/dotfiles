#!/usr/bin/env python3
"""Extract result[KEY] from an ACP response matching TARGET_ID (default 2).
Exit 1 for no response; 6 for an RPC error or a missing requested field.
"""
import json
import sys

if len(sys.argv) > 3:
    sys.exit("usage: acp-extract [TARGET_ID [KEY]]")
target = sys.argv[1] if len(sys.argv) > 1 else "2"
try:
    target = json.loads(target)
except json.JSONDecodeError:
    pass
key = sys.argv[2] if len(sys.argv) > 2 else None
for line in sys.stdin:
    try:
        msg = json.loads(line)
    except json.JSONDecodeError:
        continue
    if not isinstance(msg, dict) or "method" in msg or msg.get("id") != target:
        continue
    if "error" in msg or "result" not in msg:
        print("acp-extract: response failed or has no result", file=sys.stderr)
        sys.exit(6)
    value = msg["result"]
    if key and key != "result":
        if not isinstance(value, dict) or key not in value:
            print(f"acp-extract: result has no {key!r}", file=sys.stderr)
            sys.exit(6)
        value = value[key]
    print(json.dumps(value))
    sys.exit(0)
sys.exit(1)
