#!/usr/bin/env python3
"""Inspect advertised ACP capabilities without a model prompt by default.

--spike performs one prompt smoke test and requires an explicit --agent and --model.
Results describe handshake/configuration support, not filesystem confinement or
permission enforcement. A temporary cwd is not a sandbox. This replaces the old
probe's hardcoded capability matrix and unreliable timing/confinement claims.
"""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time


def request(rid, method, params):
    return {"jsonrpc": "2.0", "id": rid, "method": method, "params": params}


def call(command, requests, timeout):
    helper = Path(__file__).resolve().with_name("acp-call")
    start = time.monotonic()
    run = subprocess.run([str(helper), command, str(timeout)], text=True,
                         input="".join(json.dumps(r) + "\n" for r in requests), capture_output=True)
    if run.returncode:
        raise RuntimeError(run.stderr.strip() or f"acp-call exited {run.returncode}")
    responses = {}
    for line in run.stdout.splitlines():
        msg = json.loads(line)
        if "id" in msg and "result" in msg:
            responses[msg["id"]] = msg["result"]
    return responses, round(time.monotonic() - start, 3)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--agent", help="ACP command, e.g. 'opencode acp' or 'claude-agent-acp'")
    parser.add_argument("--model", "-m", help="exact advertised model option value for --spike")
    parser.add_argument("--spike", action="store_true", help="run a model prompt (may incur charges)")
    parser.add_argument("--timeout", type=int, default=30, help="seconds per ACP request")
    args = parser.parse_args()
    if args.timeout <= 0 or (args.spike and not (args.agent and args.model)):
        parser.error("use a positive timeout; --spike requires --agent and --model")
    if args.model and not args.spike:
        parser.error("--model requires --spike")
    commands = [args.agent] if args.agent else [cmd for exe, cmd in
                [("claude-agent-acp", "claude-agent-acp"), ("opencode", "opencode acp")]
                if shutil.which(exe)]
    if not commands:
        parser.error("no ACP agents found; install one or pass --agent")
    reports = []
    for command in commands:
        report = {"agent": command}
        try:
            with tempfile.TemporaryDirectory(prefix="acp-probe-") as cwd:
                requests = [request(1, "initialize", {"protocolVersion": 1, "clientCapabilities": {},
                            "clientInfo": {"name": "dotfiles-acp-probe", "version": "2"}}),
                            request(2, "session/new", {"cwd": cwd, "mcpServers": []})]
                responses, elapsed = call(command, requests, args.timeout)
                report.update(initialize=responses[1], session=responses[2], handshake_seconds=elapsed)
                if args.spike:
                    options = responses[2].get("configOptions", [])
                    model = next((o for o in options if o.get("category") == "model"), None)
                    if not model:
                        raise RuntimeError("agent does not advertise a model config option; no prompt sent")
                    def values(items):
                        for item in items:
                            if "value" in item:
                                yield item["value"]
                            yield from values(item.get("options", []))
                    if args.model not in set(values(model.get("options", []))):
                        raise RuntimeError("model is not an advertised option; no prompt sent")
                    # The helper fills sessionId from this new session, not the earlier probe.
                    requests += [request(3, "session/set_config_option", {"configId": model["id"], "value": args.model}),
                                 request(4, "session/prompt", {"prompt": [{"type": "text", "text": "Reply with 'acknowledged'. Do not use tools."}]})]
                    responses, elapsed = call(command, requests, args.timeout)
                    report.update(prompt=responses[4], prompt_sequence_seconds=elapsed)
                    if responses[4].get("stopReason") != "end_turn":
                        raise RuntimeError("prompt did not finish with end_turn")
        except (RuntimeError, OSError, KeyError, ValueError) as exc:
            report["error"] = str(exc)
        reports.append(report)
    print(json.dumps(reports, indent=2))
    return int(any("error" in report for report in reports))


if __name__ == "__main__":
    sys.exit(main())
